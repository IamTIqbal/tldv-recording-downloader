{
  "manifest_version": 3,
  "name": "Recording Downloader for tl;dv",
  "version": "0.1.1",
  "version_name": "0.1.1 Beta",
  "description": "Unofficial. Download your own tl;dv meeting recordings as MP4 or the original .ts.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["webRequest", "storage", "downloads", "scripting", "activeTab"],
  "host_permissions": ["https://*.tldv.io/*", "https://tldv.io/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download this tl;dv recording",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  }
}
